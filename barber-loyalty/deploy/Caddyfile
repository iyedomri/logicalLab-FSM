# Le Barbier de Carthage — HTTPS automatique + reverse proxy
# 1. DNS : A/AAAA carte.votre-domaine.tn → IP du serveur
# 2. caddy run --config /opt/barber-loyalty/deploy/Caddyfile
carte.example.tn, www.carte.example.tn {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control no-store
	}
	reverse_proxy 127.0.0.1:3000
}
